{
  "name": "Simulacao",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do solicitante"
    },
    "email": {
      "type": "string",
      "description": "E-mail"
    },
    "phone": {
      "type": "string",
      "description": "Telefone/WhatsApp"
    },
    "document": {
      "type": "string",
      "description": "CPF ou CNPJ"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "CPF",
        "CNPJ"
      ],
      "default": "CPF"
    },
    "amount": {
      "type": "number",
      "description": "Valor solicitado"
    },
    "term_days": {
      "type": "number",
      "description": "Prazo solicitado em dias"
    },
    "operation_type": {
      "type": "string",
      "enum": [
        "emprestimo",
        "cheque",
        "boleto"
      ],
      "default": "emprestimo"
    },
    "source": {
      "type": "string",
      "default": "site",
      "description": "Origem da simula\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "analisada",
        "aprovada",
        "recusada"
      ],
      "default": "pendente"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "name"
  ]
}