{
  "name": "ProdutoOperacao",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do produto de opera\u00e7\u00e3o"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "cheque",
        "duplicata",
        "boleto",
        "emprestimo",
        "assinatura"
      ],
      "default": "cheque",
      "description": "Tipo de antecipa\u00e7\u00e3o: Cheque, Duplicata ou Boleto. Identifica a natureza do t\u00edtulo (emiss\u00e3o, registro, cobran\u00e7a, compensa\u00e7\u00e3o, integra\u00e7\u00e3o Asaas) e N\u00c3O determina a f\u00f3rmula financeira. 'emprestimo' e 'assinatura' permanecem apenas para produtos hist\u00f3ricos."
    },
    "calc_mode": {
      "type": "string",
      "enum": [
        "desagio_face",
        "face_por_repasse",
        "price",
        "padrao",
        "inverso",
        "desconto_direto",
        "assinatura"
      ],
      "default": "desagio_face",
      "description": "Formato de c\u00e1lculo. desagio_face = Padr\u00e3o (face conhecida, des\u00e1gio reduz o repasse); face_por_repasse = Inverso (repasse desejado, face calculada); price = Parcelado (Tabela Price). Os valores 'padrao', 'inverso' e 'desconto_direto' s\u00e3o apelidos hist\u00f3ricos lidos por src/lib/formatosCalculo.js e nunca s\u00e3o gravados em novos produtos."
    },
    "calculo_inverso": {
      "type": "boolean",
      "default": false,
      "description": "Inverter a entrada: informar o repasse (ou a parcela) e calcular o valor de face. \u00c9 a op\u00e7\u00e3o de invers\u00e3o do formato escolhido."
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o exibida no seletor de produtos"
    },
    "default_rate": {
      "type": "number",
      "default": 0,
      "description": "Taxa padr\u00e3o a.m. (%)"
    },
    "default_interest_type": {
      "type": "string",
      "enum": [
        "simples",
        "composto"
      ],
      "default": "simples"
    },
    "default_tarifa_operacao": {
      "type": "number",
      "default": 0,
      "description": "Tarifa padr\u00e3o da opera\u00e7\u00e3o (R$)"
    },
    "default_tarifa_por_titulo": {
      "type": "number",
      "default": 0,
      "description": "Tarifa padr\u00e3o por t\u00edtulo (R$)"
    },
    "default_float_dias": {
      "type": "number",
      "default": 0,
      "description": "Float padr\u00e3o em dias"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Produto ativo para sele\u00e7\u00e3o em novas opera\u00e7\u00f5es"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o no seletor"
    }
  },
  "required": [
    "nome",
    "tipo",
    "calc_mode"
  ]
}