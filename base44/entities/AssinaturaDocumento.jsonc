{
  "name": "AssinaturaDocumento",
  "type": "object",
  "properties": {
    "document_type": {
      "type": "string",
      "enum": [
        "contrato",
        "promissoria",
        "confissao_divida",
        "cessao_credito",
        "termo_garantia",
        "contrato_mae",
        "promissoria_limite",
        "outro"
      ],
      "default": "contrato"
    },
    "document_number": {
      "type": "string",
      "description": "N\u00famero \u00fanico do documento (auto-gerado)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do documento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o ou observa\u00e7\u00f5es"
    },
    "pdf_file": {
      "type": "string",
      "description": "URL do arquivo PDF do documento"
    },
    "document_hash": {
      "type": "string",
      "description": "Hash SHA-256 do PDF original"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "aguardando_assinatura",
        "assinado",
        "recusado",
        "cancelado",
        "expirado"
      ],
      "default": "rascunho"
    },
    "public_link": {
      "type": "string",
      "description": "UUID do link p\u00fablico de assinatura"
    },
    "link_expires_at": {
      "type": "string",
      "format": "date",
      "description": "Data de expira\u00e7\u00e3o do link (30 dias)"
    },
    "operation_id": {
      "type": "string",
      "description": "V\u00ednculo com opera\u00e7\u00e3o (opcional)"
    },
    "client_id": {
      "type": "string",
      "description": "V\u00ednculo com cedente (opcional)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "document_type"
  ]
}