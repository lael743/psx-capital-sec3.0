{
  "name": "ParcelaCliente",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "operation_id": {
      "type": "string",
      "description": "V\u00ednculo com opera\u00e7\u00e3o de origem"
    },
    "lancamento_id": {
      "type": "string",
      "description": "V\u00ednculo com lan\u00e7amento da conta corrente"
    },
    "number": {
      "type": "number",
      "description": "N\u00famero da parcela (1, 2, 3...)"
    },
    "original_value": {
      "type": "number"
    },
    "corrected_value": {
      "type": "number"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "paga",
        "atrasada",
        "cancelada"
      ],
      "default": "pendente"
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "remaining_amount": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "asaas_payment_id": {
      "type": "string",
      "description": "ID da cobran\u00e7a no Asaas (pay_xxx)"
    },
    "asaas_billing_type": {
      "type": "string",
      "enum": [
        "PIX",
        "BOLETO"
      ],
      "description": "M\u00e9todo de cobran\u00e7a Asaas"
    },
    "asaas_pix_qrcode": {
      "type": "string",
      "description": "Payload do QR Code PIX (copia e cola)"
    },
    "asaas_boleto_line": {
      "type": "string",
      "description": "Linha digit\u00e1vel do boleto"
    },
    "asaas_payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "received",
        "overdue",
        "refunded",
        "deleted"
      ],
      "description": "Status da cobran\u00e7a no Asaas"
    }
  },
  "required": [
    "client_id",
    "number",
    "original_value",
    "due_date"
  ]
}