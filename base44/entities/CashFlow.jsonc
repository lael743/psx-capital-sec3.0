{
  "name": "CashFlow",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "default": "entrada"
    },
    "category": {
      "type": "string",
      "description": "Categoria (ex: compensacao_cheque, lancamento_avulso, transferencia_interna, etc)"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "operation_id": {
      "type": "string",
      "description": "Vinculo com operacao (obrigatorio para categorias operacionais)"
    },
    "payment_id": {
      "type": "string",
      "description": "Vinculo com pagamento (opcional)"
    },
    "bank_id": {
      "type": "string",
      "description": "ID do Banco (nao o nome). Obrigatorio para categorias bancarias. Lan\u00e7amento sem bank_id N\u00c3O \u00e9 atribu\u00edvel a conta alguma \u2014 o relat\u00f3rio em modo sombra o lista em nao_atribuidos."
    },
    "transfer_id": {
      "type": "string",
      "description": "Identificador da transfer\u00eancia entre contas. As duas pernas compartilham este valor \u2014 \u00e9 o \u00daNICO crit\u00e9rio de pareamento aceito (valor+data n\u00e3o \u00e9 pareamento v\u00e1lido). Ver src/lib/bankLedger.js."
    },
    "transfer_leg": {
      "type": "string",
      "enum": [
        "saida",
        "entrada"
      ],
      "description": "Qual perna da transfer\u00eancia este lan\u00e7amento representa."
    },
    "source_type": {
      "type": "string",
      "description": "Tipo da origem do evento financeiro (ex: cheque_compensacao, asaas_payment, pagamento_manual, transferencia_bancaria). Usado para idempotencia junto com source_id."
    },
    "source_id": {
      "type": "string",
      "description": "ID da origem do evento (ex: ID do cheque, ID do pagamento Asaas, '<transfer_id>:<perna>'). Usado para idempotencia junto com source_type."
    },
    "method": {
      "type": "string",
      "enum": [
        "pix",
        "dinheiro",
        "transferencia",
        "cheque",
        "outro"
      ]
    },
    "balance_after": {
      "type": "number",
      "description": "Saldo apos lancamento (informativo \u2014 n\u00e3o \u00e9 fonte de verdade; escritas concorrentes podem torn\u00e1-lo impreciso)"
    }
  },
  "required": [
    "type",
    "amount",
    "date",
    "description"
  ]
}