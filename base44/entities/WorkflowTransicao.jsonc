{
  "name": "WorkflowTransicao",
  "type": "object",
  "description": "Di\u00e1rio de transi\u00e7\u00f5es de etapa. Gravado ANTES do compare-and-swap e conclu\u00eddo depois dos efeitos, para que uma falha parcial (etapa trocada sem efeito nos t\u00edtulos, ou sem auditoria) seja retomada em vez de repetida \u00e0s cegas.",
  "properties": {
    "operation_id": {
      "type": "string",
      "description": "Opera\u00e7\u00e3o alvo da transi\u00e7\u00e3o."
    },
    "acao": {
      "type": "string",
      "description": "A\u00e7\u00e3o solicitada (avancar, rejeitar, reabrir, voltar_rascunho)."
    },
    "de": {
      "type": "string",
      "description": "Etapa observada pelo servidor quando a transi\u00e7\u00e3o foi decidida."
    },
    "para": {
      "type": "string",
      "description": "Etapa de destino decidida pelo servidor."
    },
    "motivo": {
      "type": "string"
    },
    "correlacao": {
      "type": "string",
      "description": "Identidade do evento. \u00c9 a chave de idempot\u00eancia da auditoria e do retry."
    },
    "cancelar": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de t\u00edtulos que a transi\u00e7\u00e3o deve cancelar."
    },
    "restaurar": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de t\u00edtulos que a transi\u00e7\u00e3o deve devolver a pendente."
    },
    "estado": {
      "type": "string",
      "enum": [
        "iniciada",
        "abortada",
        "aplicada",
        "concluida"
      ],
      "default": "iniciada",
      "description": "iniciada = di\u00e1rio gravado, etapa ainda n\u00e3o confirmada; abortada = CAS n\u00e3o venceu (nada foi aplicado); aplicada = etapa trocada, efeitos pendentes; concluida = t\u00edtulos e auditoria confirmados."
    },
    "etapa_apos": {
      "type": "string",
      "description": "Etapa observada na \u00faltima tentativa de concluir os efeitos."
    },
    "erro": {
      "type": "string"
    },
    "solicitante": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio autenticado que pediu a transi\u00e7\u00e3o (vem do token)."
    }
  },
  "required": [
    "operation_id",
    "acao",
    "estado"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "___somente_servidor___"
    },
    "update": {
      "created_by_id": "___somente_servidor___"
    },
    "delete": {
      "created_by_id": "___somente_servidor___"
    }
  }
}