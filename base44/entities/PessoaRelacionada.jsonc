{
  "name": "PessoaRelacionada",
  "type": "object",
  "properties": {
    "cedente_id": {
      "type": "string",
      "description": "ID do cedente vinculado"
    },
    "nome": {
      "type": "string",
      "description": "Nome completo"
    },
    "cpf": {
      "type": "string",
      "description": "CPF"
    },
    "funcao": {
      "type": "string",
      "enum": [
        "socio",
        "avalista",
        "responsavel",
        "gerente",
        "procurador",
        "outro"
      ],
      "default": "socio",
      "description": "Fun\u00e7\u00e3o/papel da pessoa relacionada"
    },
    "pode_assinar": {
      "type": "boolean",
      "default": false,
      "description": "Se possui poderes para assinar documentos"
    },
    "email": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "cep": {
      "type": "string"
    },
    "logradouro": {
      "type": "string"
    },
    "cidade": {
      "type": "string"
    },
    "uf": {
      "type": "string"
    }
  },
  "required": [
    "cedente_id",
    "nome",
    "cpf"
  ]
}