{
  "name": "AsaasEvento",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string",
      "description": "Identidade externa do evento (id do pagamento Asaas). Chave de idempot\u00eancia."
    },
    "status": {
      "type": "string",
      "enum": [
        "reivindicado",
        "em_recuperacao",
        "contabilizado",
        "falha",
        "falha_definitiva"
      ],
      "default": "reivindicado",
      "description": "Estado do evento. reivindicado = recebido, efeitos n\u00e3o confirmados. em_recuperacao = a recupera\u00e7\u00e3o det\u00e9m o evento por compare-and-swap. contabilizado = todos os efeitos confirmados. falha = erro transit\u00f3rio, recuper\u00e1vel. falha_definitiva = esgotou as tentativas, exige interven\u00e7\u00e3o manual."
    },
    "operation_id": {
      "type": "string",
      "description": "Operacao alvo do efeito monetario (vazio no caminho parcela, que nao amortiza a operacao)."
    },
    "parcela_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string",
      "description": "ID da cobranca no Asaas (pay_xxx)"
    },
    "external_reference": {
      "type": "string",
      "description": "externalReference original enviada ao Asaas"
    },
    "value": {
      "type": "number",
      "description": "Valor do recebimento deste evento"
    },
    "claimed_at": {
      "type": "string",
      "description": "Instante ISO em que o evento foi reivindicado"
    },
    "recovery_started_at": {
      "type": "string",
      "description": "Instante ISO em que a recupera\u00e7\u00e3o reivindicou o evento. Base do prazo de validade da reivindica\u00e7\u00e3o: uma recupera\u00e7\u00e3o abandonada \u00e9 retomada ap\u00f3s a toler\u00e2ncia."
    },
    "accounted_at": {
      "type": "string",
      "description": "Instante ISO em que todos os efeitos foram confirmados"
    },
    "error": {
      "type": "string",
      "description": "Mensagem do ultimo erro de aplicacao"
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "Numero de tentativas de recuperacao. Ao atingir MAX_TENTATIVAS o evento vira falha_definitiva e sai da recuperacao automatica."
    },
    "effects": {
      "type": "object",
      "description": "Efeitos confirmados no banco: amount_paid (bool) e lancamento_id."
    },
    "lancamento_payload": {
      "type": "object",
      "description": "Payload do lancamento de extrato do cliente. Permite recriar o efeito faltante na recuperacao."
    }
  },
  "required": [
    "event_key",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}