{
  "name": "Document",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "contrato",
        "duplicata",
        "recibo",
        "outro"
      ],
      "default": "contrato"
    },
    "doc_number": {
      "type": "string",
      "description": "N\u00famero do documento"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "content": {
      "type": "string",
      "description": "Conte\u00fado HTML/texto do documento"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "file_url": {
      "type": "string",
      "description": "URL do PDF gerado"
    },
    "signed_file_url": {
      "type": "string",
      "description": "URL do contrato assinado"
    },
    "is_signed": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "client_id",
    "doc_type"
  ]
}